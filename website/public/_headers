# Cloudflare static assets headers.
# Markdown and JSON copies of the docs are for AI tools and search, keep them
# out of search results so they don't compete with the HTML pages.
/llms.txt
  X-Robots-Tag: noindex
/llms-full.txt
  X-Robots-Tag: noindex
/llms.mdx/*
  X-Robots-Tag: noindex
/api/*
  X-Robots-Tag: noindex
